<?xml version="1.0" encoding="utf-8"?>
<!-- List item containers. -->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- A row with no hover, press or selection look of its own. For lists that only display content. -->
    <Style x:Key="PlainListItemStyle" TargetType="ListViewItem">
        <Setter Property="Padding" Value="{StaticResource Inset0}" />
        <Setter Property="Margin" Value="{StaticResource InsetRowGap}" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListViewItem">
                    <ContentPresenter
                        Margin="{TemplateBinding Padding}"
                        HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
