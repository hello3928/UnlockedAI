<?xml version="1.0" encoding="utf-8"?>
<!--
    Design tokens. This is the only file that holds raw colours, sizes and spacing.
    Styles and controls read these keys; views use the styles and controls.
    Colour values follow the Windows 11 dark palette.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Surfaces (translucent so the Mica backdrop shows through) -->
    <SolidColorBrush x:Key="LayerBrush" Color="#4C3A3A3A" />
    <SolidColorBrush x:Key="CardBrush" Color="#0DFFFFFF" />
    <SolidColorBrush x:Key="InsetBrush" Color="#33000000" />
    <SolidColorBrush x:Key="TransparentBrush" Color="Transparent" />

    <!-- Control fills -->
    <SolidColorBrush x:Key="ControlBrush" Color="#0FFFFFFF" />
    <SolidColorBrush x:Key="ControlHoverBrush" Color="#15FFFFFF" />
    <SolidColorBrush x:Key="ControlPressedBrush" Color="#08FFFFFF" />
    <SolidColorBrush x:Key="ControlDisabledBrush" Color="#0BFFFFFF" />
    <SolidColorBrush x:Key="SubtleHoverBrush" Color="#0FFFFFFF" />
    <SolidColorBrush x:Key="SubtlePressedBrush" Color="#0AFFFFFF" />

    <!-- Strokes -->
    <SolidColorBrush x:Key="ControlStrokeBrush" Color="#12FFFFFF" />
    <SolidColorBrush x:Key="DividerBrush" Color="#15FFFFFF" />

    <!-- Text -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#C5FFFFFF" />
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="#87FFFFFF" />
    <SolidColorBrush x:Key="TextDisabledBrush" Color="#5DFFFFFF" />
    <SolidColorBrush x:Key="TextOnAccentBrush" Color="#000000" />

    <!-- Accent: the user's own Windows accent colour -->
    <SolidColorBrush x:Key="AccentBrush" Color="{ThemeResource SystemAccentColorLight2}" />
    <SolidColorBrush x:Key="AccentHoverBrush" Opacity="0.9" Color="{ThemeResource SystemAccentColorLight2}" />
    <SolidColorBrush x:Key="AccentPressedBrush" Opacity="0.8" Color="{ThemeResource SystemAccentColorLight2}" />
    <SolidColorBrush x:Key="AccentDisabledBrush" Color="#28FFFFFF" />
    <SolidColorBrush x:Key="AccentTextBrush" Color="{ThemeResource SystemAccentColorLight3}" />

    <!-- Status -->
    <SolidColorBrush x:Key="ErrorBrush" Color="#FF99A4" />
    <SolidColorBrush x:Key="ErrorHoverBrush" Opacity="0.9" Color="#FF99A4" />
    <SolidColorBrush x:Key="ErrorPressedBrush" Opacity="0.8" Color="#FF99A4" />
    <SolidColorBrush x:Key="ErrorSurfaceBrush" Color="#442726" />
    <SolidColorBrush x:Key="WarningBrush" Color="#FCE100" />
    <SolidColorBrush x:Key="WarningSurfaceBrush" Color="#433519" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#6CCB5F" />
    <SolidColorBrush x:Key="SuccessSurfaceBrush" Color="#393D1B" />

    <!-- Spacing: 4px grid. Doubles are for Spacing properties, Insets for Padding and Margin. -->
    <x:Double x:Key="Space1">4</x:Double>
    <x:Double x:Key="Space2">8</x:Double>
    <x:Double x:Key="Space3">12</x:Double>
    <x:Double x:Key="Space4">16</x:Double>
    <x:Double x:Key="Space6">24</x:Double>
    <x:Double x:Key="Space8">32</x:Double>

    <Thickness x:Key="Inset0">0</Thickness>
    <Thickness x:Key="Inset1">4</Thickness>
    <Thickness x:Key="Inset2">8</Thickness>
    <Thickness x:Key="Inset3">12</Thickness>
    <Thickness x:Key="Inset4">16</Thickness>
    <Thickness x:Key="Inset6">24</Thickness>
    <Thickness x:Key="InsetButton">12,0</Thickness>
    <Thickness x:Key="InsetChip">8,2,2,2</Thickness>
    <Thickness x:Key="InsetRow">12,8</Thickness>
    <Thickness x:Key="InsetTitleBar">16,0</Thickness>
    <Thickness x:Key="InsetMessage">16,8,8,12</Thickness>
    <Thickness x:Key="InsetMessageBody">0,0,8,0</Thickness>
    <Thickness x:Key="InsetRowGap">0,2</Thickness>
    <Thickness x:Key="InsetPage">16,0</Thickness>
    <Thickness x:Key="InsetList">16,8,16,8</Thickness>
    <Thickness x:Key="InsetHeader">16,12,16,4</Thickness>
    <Thickness x:Key="InsetCode">12,4,4,4</Thickness>
    <Thickness x:Key="InsetCodeBody">12,0,12,12</Thickness>
    <Thickness x:Key="InsetQuote">12,0,0,0</Thickness>
    <Thickness x:Key="InsetCell">8,4</Thickness>
    <Thickness x:Key="InsetParagraphGap">0,8,0,0</Thickness>
    <Thickness x:Key="InsetHeadingGap">0,12,0,0</Thickness>
    <Thickness x:Key="InsetPageBottom">16,8,16,16</Thickness>
    <Thickness x:Key="InsetPageTop">16,16,16,0</Thickness>

    <!-- Shape -->
    <CornerRadius x:Key="RadiusControl">4</CornerRadius>
    <CornerRadius x:Key="RadiusPanel">8</CornerRadius>
    <CornerRadius x:Key="RadiusContent">8,0,0,0</CornerRadius>
    <Thickness x:Key="StrokeTopLeft">1,1,0,0</Thickness>
    <Thickness x:Key="StrokeTop">0,1,0,0</Thickness>
    <Thickness x:Key="StrokeQuote">2,0,0,0</Thickness>
    <x:Double x:Key="RuleHeight">1</x:Double>
    <x:Double x:Key="ListMarkerWidth">20</x:Double>
    <Thickness x:Key="StrokeThin">1</Thickness>
    <Thickness x:Key="StrokeBottom">0,0,0,1</Thickness>
    <Thickness x:Key="StrokeRight">0,0,1,0</Thickness>
    <Thickness x:Key="FocusMargin">-3</Thickness>

    <!-- Sizes -->
    <x:Double x:Key="ControlHeight">32</x:Double>
    <x:Double x:Key="ControlHeightCompact">24</x:Double>
    <x:Double x:Key="IconSize">16</x:Double>
    <x:Double x:Key="IconSizeSmall">12</x:Double>
    <x:Double x:Key="IconSizeLarge">32</x:Double>
    <x:Double x:Key="TitleBarHeight">40</x:Double>
    <x:Double x:Key="SidebarWidth">260</x:Double>
    <GridLength x:Key="SidebarColumn">260</GridLength>
    <x:Double x:Key="ModelPickerWidth">240</x:Double>
    <x:Double x:Key="ReadingWidth">760</x:Double>
    <x:Double x:Key="EmptyStateWidth">360</x:Double>
    <x:Double x:Key="ChipTextWidth">200</x:Double>
    <x:Double x:Key="ComposerMaxHeight">200</x:Double>
    <x:Double x:Key="TextAreaMinHeight">96</x:Double>
    <x:Double x:Key="DialogContentWidth">460</x:Double>

    <!-- Type ramp -->
    <x:Double x:Key="FontSizeCaption">12</x:Double>
    <x:Double x:Key="FontSizeBody">14</x:Double>
    <x:Double x:Key="FontSizeHeading3">15</x:Double>
    <x:Double x:Key="FontSizeHeading2">17</x:Double>
    <x:Double x:Key="FontSizeSubtitle">20</x:Double>
    <x:Double x:Key="FontSizeTitle">28</x:Double>
    <x:Double x:Key="FontSizeMono">13</x:Double>
    <x:Double x:Key="LineHeightCaption">16</x:Double>
    <x:Double x:Key="LineHeightBody">20</x:Double>
    <x:Double x:Key="LineHeightSubtitle">28</x:Double>
    <x:Double x:Key="LineHeightTitle">36</x:Double>
    <FontFamily x:Key="FontFamilyMono">Cascadia Mono, Consolas</FontFamily>

    <!-- Opacity -->
    <x:Double x:Key="OpacityPressedContent">0.8</x:Double>

</ResourceDictionary>
