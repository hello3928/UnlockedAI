<?xml version="1.0" encoding="utf-8"?>
<!-- Looks for the layout controls: Card, FormRow, SectionHeader. -->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="using:UnlockedAI.Controls">

    <Style TargetType="ui:Card">
        <Setter Property="Background" Value="{StaticResource CardBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource ControlStrokeBrush}" />
        <Setter Property="BorderThickness" Value="{StaticResource StrokeThin}" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusPanel}" />
        <Setter Property="Padding" Value="{StaticResource Inset4}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ui:Card">
                    <Border
                        Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}">
                        <ContentPresenter
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ui:FormRow">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ui:FormRow">
                    <StackPanel Spacing="{StaticResource Space1}">
                        <TextBlock
                            x:Name="PART_Label"
                            Style="{StaticResource BodyText}"
                            Text="{TemplateBinding Label}" />
                        <ContentPresenter
                            x:Name="PART_Content"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            Content="{TemplateBinding Content}" />
                        <TextBlock
                            x:Name="PART_Description"
                            Style="{StaticResource CaptionText}"
                            Text="{TemplateBinding Description}" />
                        <TextBlock
                            x:Name="PART_Error"
                            Style="{StaticResource CaptionErrorText}"
                            Text="{TemplateBinding Error}" />
                    </StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ui:SectionHeader">
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="AutomationProperties.HeadingLevel" Value="Level2" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ui:SectionHeader">
                    <TextBlock Style="{StaticResource BodyStrongText}" Text="{TemplateBinding Text}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
