<?xml version="1.0" encoding="utf-8"?>
<!--
    Looks for AppButton and IconButton. One template, one style per variant.
    AppButton picks the style from its Variant property; views never reference these keys.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="using:UnlockedAI.Controls">

    <ControlTemplate x:Key="AppButtonTemplate" TargetType="ui:AppButton">
        <Grid Background="{StaticResource TransparentBrush}">
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="PointerOver">
                        <VisualState.Setters>
                            <Setter Target="NormalLayer.Opacity" Value="0" />
                            <Setter Target="HoverLayer.Opacity" Value="1" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Target="NormalLayer.Opacity" Value="0" />
                            <Setter Target="PressedLayer.Opacity" Value="1" />
                            <Setter Target="ContentRow.Opacity" Value="{StaticResource OpacityPressedContent}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Target="NormalLayer.Opacity" Value="0" />
                            <Setter Target="DisabledLayer.Opacity" Value="1" />
                            <Setter Target="PART_Label.Foreground" Value="{StaticResource TextDisabledBrush}" />
                            <Setter Target="PART_Icon.Foreground" Value="{StaticResource TextDisabledBrush}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>

            <!-- One fill per state, cross-faded, so each variant can give exact colours. -->
            <Border
                x:Name="NormalLayer"
                Background="{TemplateBinding Background}"
                CornerRadius="{TemplateBinding CornerRadius}" />
            <Border
                x:Name="HoverLayer"
                Background="{TemplateBinding HoverBackground}"
                CornerRadius="{TemplateBinding CornerRadius}"
                Opacity="0" />
            <Border
                x:Name="PressedLayer"
                Background="{TemplateBinding PressedBackground}"
                CornerRadius="{TemplateBinding CornerRadius}"
                Opacity="0" />
            <Border
                x:Name="DisabledLayer"
                Background="{TemplateBinding DisabledBackground}"
                CornerRadius="{TemplateBinding CornerRadius}"
                Opacity="0" />
            <Border
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}" />

            <StackPanel
                x:Name="ContentRow"
                Margin="{TemplateBinding Padding}"
                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                Orientation="Horizontal"
                Spacing="{StaticResource Space2}">
                <ProgressRing
                    x:Name="PART_Busy"
                    Width="{StaticResource IconSize}"
                    Height="{StaticResource IconSize}"
                    MinWidth="{StaticResource IconSize}"
                    MinHeight="{StaticResource IconSize}"
                    VerticalAlignment="Center"
                    Foreground="{TemplateBinding Foreground}"
                    IsActive="False"
                    Visibility="Collapsed" />
                <FontIcon
                    x:Name="PART_Icon"
                    VerticalAlignment="Center"
                    FontSize="{StaticResource IconSize}"
                    Foreground="{TemplateBinding Foreground}"
                    Visibility="Collapsed" />
                <ContentPresenter
                    x:Name="PART_Label"
                    VerticalAlignment="Center"
                    Content="{TemplateBinding Content}"
                    FontSize="{TemplateBinding FontSize}"
                    FontWeight="{TemplateBinding FontWeight}"
                    Foreground="{TemplateBinding Foreground}" />
            </StackPanel>
        </Grid>
    </ControlTemplate>

    <Style x:Key="AppButtonBaseStyle" TargetType="ui:AppButton">
        <Setter Property="Template" Value="{StaticResource AppButtonTemplate}" />
        <Setter Property="MinHeight" Value="{StaticResource ControlHeight}" />
        <Setter Property="Padding" Value="{StaticResource InsetButton}" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusControl}" />
        <Setter Property="BorderThickness" Value="{StaticResource StrokeThin}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="FocusVisualMargin" Value="{StaticResource FocusMargin}" />
    </Style>

    <Style x:Key="AppButtonSecondaryStyle" BasedOn="{StaticResource AppButtonBaseStyle}" TargetType="ui:AppButton">
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="Background" Value="{StaticResource ControlBrush}" />
        <Setter Property="HoverBackground" Value="{StaticResource ControlHoverBrush}" />
        <Setter Property="PressedBackground" Value="{StaticResource ControlPressedBrush}" />
        <Setter Property="DisabledBackground" Value="{StaticResource ControlDisabledBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource ControlStrokeBrush}" />
    </Style>

    <Style x:Key="AppButtonPrimaryStyle" BasedOn="{StaticResource AppButtonBaseStyle}" TargetType="ui:AppButton">
        <Setter Property="Foreground" Value="{StaticResource TextOnAccentBrush}" />
        <Setter Property="Background" Value="{StaticResource AccentBrush}" />
        <Setter Property="HoverBackground" Value="{StaticResource AccentHoverBrush}" />
        <Setter Property="PressedBackground" Value="{StaticResource AccentPressedBrush}" />
        <Setter Property="DisabledBackground" Value="{StaticResource AccentDisabledBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource TransparentBrush}" />
    </Style>

    <Style x:Key="AppButtonGhostStyle" BasedOn="{StaticResource AppButtonBaseStyle}" TargetType="ui:AppButton">
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="Background" Value="{StaticResource TransparentBrush}" />
        <Setter Property="HoverBackground" Value="{StaticResource SubtleHoverBrush}" />
        <Setter Property="PressedBackground" Value="{StaticResource SubtlePressedBrush}" />
        <Setter Property="DisabledBackground" Value="{StaticResource TransparentBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource TransparentBrush}" />
    </Style>

    <Style x:Key="AppButtonDangerStyle" BasedOn="{StaticResource AppButtonBaseStyle}" TargetType="ui:AppButton">
        <Setter Property="Foreground" Value="{StaticResource TextOnAccentBrush}" />
        <Setter Property="Background" Value="{StaticResource ErrorBrush}" />
        <Setter Property="HoverBackground" Value="{StaticResource ErrorHoverBrush}" />
        <Setter Property="PressedBackground" Value="{StaticResource ErrorPressedBrush}" />
        <Setter Property="DisabledBackground" Value="{StaticResource AccentDisabledBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource TransparentBrush}" />
    </Style>

</ResourceDictionary>
