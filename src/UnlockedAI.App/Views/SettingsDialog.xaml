<?xml version="1.0" encoding="utf-8"?>
<ui:AppDialog
    x:Class="UnlockedAI.Views.SettingsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="using:UnlockedAI.Controls"
    xmlns:vm="using:UnlockedAI.ViewModels"
    Title="Settings"
    CloseButtonText="Cancel"
    IsPrimaryButtonEnabled="{x:Bind ViewModel.CanSave, Mode=OneWay}"
    PrimaryButtonClick="OnSaveClick"
    PrimaryButtonText="Save">

    <!-- A dialog doesn't scroll its content by itself, and this is taller than a small window. -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel
        MinWidth="{StaticResource DialogContentWidth}"
        Padding="{StaticResource InsetScrollContent}"
        Spacing="{StaticResource Space4}">

        <ui:ErrorMessage
            DismissCommand="{x:Bind ViewModel.DismissErrorCommand}"
            Error="{x:Bind ViewModel.Error, Mode=OneWay}" />

        <ui:SectionHeader Text="Connection" />

        <ui:FormRow
            Description="Where Ollama is listening. The default is http://localhost:11434."
            Error="{x:Bind ViewModel.OllamaUrlError, Mode=OneWay}"
            Label="Ollama address">
            <TextBox IsSpellCheckEnabled="False" Text="{x:Bind ViewModel.OllamaUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        </ui:FormRow>

        <ui:SectionHeader Text="Model" />

        <ui:FormRow Description="Used for new chats. Each chat can switch model from its own menu." Label="Default model">
            <ComboBox
                HorizontalAlignment="Stretch"
                ItemsSource="{x:Bind ViewModel.ModelNames}"
                SelectedItem="{x:Bind ViewModel.DefaultModel, Mode=TwoWay}" />
        </ui:FormRow>

        <ui:FormRow Description="Optional. Instructions the model follows in every chat." Label="System prompt">
            <TextBox
                MinHeight="{StaticResource TextAreaMinHeight}"
                MaxHeight="{StaticResource ComposerMaxHeight}"
                AcceptsReturn="True"
                ScrollViewer.VerticalScrollBarVisibility="Auto"
                Text="{x:Bind ViewModel.SystemPrompt, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                TextWrapping="Wrap" />
        </ui:FormRow>

        <ui:FormRow Description="Lower is more focused and repeatable. Higher is more varied." Label="{x:Bind ViewModel.TemperatureLabel, Mode=OneWay}">
            <Slider
                Maximum="2"
                Minimum="0"
                StepFrequency="0.1"
                Value="{x:Bind ViewModel.Temperature, Mode=TwoWay}" />
        </ui:FormRow>

        <ui:FormRow Description="How much of the chat the model can see at once. Larger values use more memory." Label="Context length">
            <ComboBox
                HorizontalAlignment="Stretch"
                ItemsSource="{x:Bind ViewModel.ContextLengths}"
                SelectedItem="{x:Bind ViewModel.ContextLength, Mode=TwoWay}" />
        </ui:FormRow>

        <ui:FormRow Description="How long Ollama keeps the model in memory after a reply. A loaded model uses several gigabytes." Label="Unload model after">
            <ComboBox
                HorizontalAlignment="Stretch"
                ItemsSource="{x:Bind ViewModel.KeepAliveOptions}"
                SelectedItem="{x:Bind ViewModel.KeepAlive, Mode=TwoWay}" />
        </ui:FormRow>

        <ui:SectionHeader Text="Tools" />

        <ui:FormRow Description="Applies to running commands, writing files, and requests to this PC or your local network. Searching and reading the web never ask." Label="Before a tool changes this PC">
            <ComboBox
                HorizontalAlignment="Stretch"
                ItemsSource="{x:Bind ViewModel.ApprovalOptions}"
                SelectedItem="{x:Bind ViewModel.Approval, Mode=TwoWay}" />
        </ui:FormRow>

        <ui:Notice
            Title="Nothing will check what the model runs"
            Message="It will be able to run any command and change any file you can. Text on a web page or in a file it reads can talk it into doing so."
            Severity="Warning"
            Visibility="{x:Bind ui:Visible.If(ViewModel.IsAutoApprove), Mode=OneWay}" />

        <ui:FormRow Description="Untick a tool and the model is never offered it." Label="Tools the model can use">
            <ItemsControl IsTabStop="False" ItemsSource="{x:Bind ViewModel.Tools}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ToolToggleViewModel">
                        <CheckBox AutomationProperties.Name="{x:Bind Title}" IsChecked="{x:Bind IsEnabled, Mode=TwoWay}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource BodyText}" Text="{x:Bind Title}" />
                                <TextBlock Style="{StaticResource CaptionText}" Text="{x:Bind Summary}" />
                            </StackPanel>
                        </CheckBox>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ui:FormRow>

        <ui:FormRow Description="A command still running after this long is stopped." Label="Command time limit">
            <ComboBox
                HorizontalAlignment="Stretch"
                ItemsSource="{x:Bind ViewModel.TimeoutOptions}"
                SelectedItem="{x:Bind ViewModel.CommandTimeout, Mode=TwoWay}" />
        </ui:FormRow>

        <ui:FormRow
            Description="Where commands start and where relative file paths are looked up. Leave empty for your user folder."
            Error="{x:Bind ViewModel.WorkingDirectoryError, Mode=OneWay}"
            Label="Working folder">
            <TextBox IsSpellCheckEnabled="False" Text="{x:Bind ViewModel.WorkingDirectory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        </ui:FormRow>

        <ui:FormRow Description="Optional. With the key from a free ollama.com account, web search uses Ollama Web Search. Without one it uses DuckDuckGo. The key is kept in Windows Credential Manager." Label="Ollama API key">
            <PasswordBox Password="{x:Bind ViewModel.OllamaApiKey, Mode=TwoWay}" />
        </ui:FormRow>
    </StackPanel>
    </ScrollViewer>
</ui:AppDialog>
