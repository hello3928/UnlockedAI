<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="UnlockedAI.Views.ChatView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="using:UnlockedAI.Controls"
    xmlns:vm="using:UnlockedAI.ViewModels"
    IsTabStop="False">

    <UserControl.KeyboardAccelerators>
        <KeyboardAccelerator Key="Escape" Invoked="OnEscapeInvoked" />
    </UserControl.KeyboardAccelerators>

    <!-- The transparent background makes the whole column a drop target, not just its children. -->
    <Grid
        AllowDrop="True"
        Background="{StaticResource TransparentBrush}"
        DragOver="OnDragOver"
        Drop="OnDrop">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Padding="{StaticResource InsetHeader}">
            <ui:ModelPicker
                HorizontalAlignment="Left"
                Models="{x:Bind ViewModel.Models, Mode=OneWay}"
                SelectedModel="{x:Bind ViewModel.SelectedModel, Mode=TwoWay}" />
        </Grid>

        <ui:ErrorMessage
            Grid.Row="1"
            MaxWidth="{StaticResource ReadingWidth}"
            Margin="{StaticResource InsetPage}"
            DismissCommand="{x:Bind ViewModel.DismissErrorCommand, Mode=OneWay}"
            Error="{x:Bind ViewModel.Error, Mode=OneWay}"
            RetryCommand="{x:Bind ViewModel.RetryCommand, Mode=OneWay}" />

        <ListView
            x:Name="MessageList"
            Grid.Row="2"
            Padding="{StaticResource InsetList}"
            AutomationProperties.Name="Messages"
            IsItemClickEnabled="False"
            ItemContainerStyle="{StaticResource PlainListItemStyle}"
            ItemsSource="{x:Bind ViewModel.Messages, Mode=OneWay}"
            SelectionMode="None">
            <ListView.ItemsPanel>
                <ItemsPanelTemplate>
                    <ItemsStackPanel ItemsUpdatingScrollMode="KeepLastItemInView" />
                </ItemsPanelTemplate>
            </ListView.ItemsPanel>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:MessageViewModel">
                    <ui:MessageRow MaxWidth="{StaticResource ReadingWidth}" Message="{x:Bind}" />
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <ui:EmptyState
            Title="What do you want to ask?"
            Grid.Row="2"
            Icon="Chat"
            Message="Enter sends. Shift+Enter adds a line."
            Visibility="{x:Bind ui:Visible.If(ViewModel.IsEmpty), Mode=OneWay}" />

        <ui:Notice
            Title="Too much text for the model"
            Grid.Row="3"
            MaxWidth="{StaticResource ReadingWidth}"
            Margin="{StaticResource InsetPage}"
            Message="{x:Bind ViewModel.AttachmentWarning, Mode=OneWay}"
            Severity="Warning"
            Visibility="{x:Bind ui:Visible.IfText(ViewModel.AttachmentWarning), Mode=OneWay}" />

        <ui:Composer
            x:Name="MessageComposer"
            Grid.Row="4"
            MaxWidth="{StaticResource ReadingWidth}"
            Margin="{StaticResource InsetPageBottom}"
            AttachCommand="{x:Bind ViewModel.AttachCommand, Mode=OneWay}"
            Attachments="{x:Bind ViewModel.PendingAttachments, Mode=OneWay}"
            HasAttachments="{x:Bind ViewModel.HasPendingAttachments, Mode=OneWay}"
            IsAttaching="{x:Bind ViewModel.IsAttaching, Mode=OneWay}"
            RemoveAttachmentCommand="{x:Bind ViewModel.RemoveAttachmentCommand, Mode=OneWay}"
            IsBusy="{x:Bind ViewModel.IsGenerating, Mode=OneWay}"
            PlaceholderText="{x:Bind ViewModel.ComposerPlaceholder, Mode=OneWay}"
            SendCommand="{x:Bind ViewModel.SendCommand, Mode=OneWay}"
            StopCommand="{x:Bind ViewModel.StopCommand, Mode=OneWay}"
            Text="{x:Bind ViewModel.Draft, Mode=TwoWay}" />
    </Grid>
</UserControl>
