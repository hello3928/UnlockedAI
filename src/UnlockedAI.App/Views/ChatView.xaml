<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="UnlockedAI.Views.ChatView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="using:UnlockedAI.Controls"
    xmlns:views="using:UnlockedAI.Views"
    xmlns:vm="using:UnlockedAI.ViewModels"
    IsTabStop="False">

    <UserControl.Resources>
        <DataTemplate x:Key="MessageTemplate" x:DataType="vm:MessageViewModel">
            <ui:MessageRow MaxWidth="{StaticResource ReadingWidth}" Message="{x:Bind}" />
        </DataTemplate>
        <DataTemplate x:Key="ToolCallTemplate" x:DataType="vm:ToolCallViewModel">
            <ui:ToolCallCard
                MaxWidth="{StaticResource ReadingWidth}"
                Margin="{StaticResource InsetToolCall}"
                Call="{x:Bind}" />
        </DataTemplate>
        <views:ChatItemTemplateSelector
            x:Key="ChatItemSelector"
            Message="{StaticResource MessageTemplate}"
            ToolCall="{StaticResource ToolCallTemplate}" />
    </UserControl.Resources>

    <UserControl.KeyboardAccelerators>
        <KeyboardAccelerator Key="Escape" Invoked="OnEscapeInvoked" />
    </UserControl.KeyboardAccelerators>

    <!-- The transparent background makes the whole column a drop target, not just its children. -->
    <Grid
        AllowDrop="True"
        Background="{StaticResource TransparentBrush}"
        DragOver="OnDragOver"
        Drop="OnDrop">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid
            Grid.Row="0"
            Padding="{StaticResource InsetHeader}"
            ColumnSpacing="{StaticResource Space3}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ui:ModelPicker
                Grid.Column="0"
                Models="{x:Bind ViewModel.Models, Mode=OneWay}"
                SelectedModel="{x:Bind ViewModel.SelectedModel, Mode=TwoWay}" />

            <!-- Off by default. With tools on offer, small models use one for almost every message. -->
            <ToggleSwitch
                Grid.Column="1"
                MinWidth="0"
                VerticalAlignment="Center"
                AutomationProperties.Name="Tools"
                IsEnabled="{x:Bind ViewModel.CanUseTools, Mode=OneWay}"
                IsOn="{x:Bind ViewModel.UseTools, Mode=TwoWay}"
                OffContent="Tools off"
                OnContent="Tools on"
                ToolTipService.ToolTip="Lets the model search the web, read and write files, and run commands. Leave it off for ordinary chat: replies are faster and nothing is looked up online." />
            <TextBlock
                Grid.Column="2"
                VerticalAlignment="Center"
                Style="{StaticResource CaptionText}"
                Text="{x:Bind ViewModel.ToolsNote, Mode=OneWay}"
                TextTrimming="CharacterEllipsis"
                TextWrapping="NoWrap" />

            <!-- Always visible while on, so running without approval is never a hidden state. -->
            <StackPanel
                Grid.Column="3"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="{StaticResource Space1}"
                ToolTipService.ToolTip="Commands and file changes run without asking. Change this in Settings."
                Visibility="{x:Bind ui:Visible.If(ViewModel.IsAutoApproveOn), Mode=OneWay}">
                <ui:IconView
                    VerticalAlignment="Center"
                    Foreground="{StaticResource WarningBrush}"
                    Icon="Warning" />
                <TextBlock
                    VerticalAlignment="Center"
                    Style="{StaticResource CaptionStrongText}"
                    Text="Auto-approve is on" />
            </StackPanel>
        </Grid>

        <ui:ErrorMessage
            Grid.Row="1"
            MaxWidth="{StaticResource ReadingWidth}"
            Margin="{StaticResource InsetPage}"
            DismissCommand="{x:Bind ViewModel.DismissErrorCommand, Mode=OneWay}"
            Error="{x:Bind ViewModel.Error, Mode=OneWay}"
            RetryCommand="{x:Bind ViewModel.RetryCommand, Mode=OneWay}" />

        <ListView
            x:Name="MessageList"
            Grid.Row="2"
            Padding="{StaticResource InsetList}"
            AutomationProperties.Name="Messages"
            IsItemClickEnabled="False"
            ItemContainerStyle="{StaticResource PlainListItemStyle}"
            ItemTemplateSelector="{StaticResource ChatItemSelector}"
            ItemsSource="{x:Bind ViewModel.Messages, Mode=OneWay}"
            SelectionMode="None">
            <ListView.ItemsPanel>
                <ItemsPanelTemplate>
                    <ItemsStackPanel ItemsUpdatingScrollMode="KeepLastItemInView" />
                </ItemsPanelTemplate>
            </ListView.ItemsPanel>
        </ListView>

        <ui:EmptyState
            Title="What do you want to ask?"
            Grid.Row="2"
            Icon="Chat"
            Message="Enter sends. Shift+Enter adds a line."
            Visibility="{x:Bind ui:Visible.If(ViewModel.IsEmpty), Mode=OneWay}" />

        <ui:Notice
            Title="Too much text for the model"
            Grid.Row="3"
            MaxWidth="{StaticResource ReadingWidth}"
            Margin="{StaticResource InsetPage}"
            Message="{x:Bind ViewModel.AttachmentWarning, Mode=OneWay}"
            Severity="Warning"
            Visibility="{x:Bind ui:Visible.IfText(ViewModel.AttachmentWarning), Mode=OneWay}" />

        <ui:Composer
            x:Name="MessageComposer"
            Grid.Row="4"
            MaxWidth="{StaticResource ReadingWidth}"
            Margin="{StaticResource InsetPageBottom}"
            AttachCommand="{x:Bind ViewModel.AttachCommand, Mode=OneWay}"
            Attachments="{x:Bind ViewModel.PendingAttachments, Mode=OneWay}"
            HasAttachments="{x:Bind ViewModel.HasPendingAttachments, Mode=OneWay}"
            IsAttaching="{x:Bind ViewModel.IsAttaching, Mode=OneWay}"
            RemoveAttachmentCommand="{x:Bind ViewModel.RemoveAttachmentCommand, Mode=OneWay}"
            IsBusy="{x:Bind ViewModel.IsGenerating, Mode=OneWay}"
            PlaceholderText="{x:Bind ViewModel.ComposerPlaceholder, Mode=OneWay}"
            SendCommand="{x:Bind ViewModel.SendCommand, Mode=OneWay}"
            StopCommand="{x:Bind ViewModel.StopCommand, Mode=OneWay}"
            Text="{x:Bind ViewModel.Draft, Mode=TwoWay}" />
    </Grid>
</UserControl>
