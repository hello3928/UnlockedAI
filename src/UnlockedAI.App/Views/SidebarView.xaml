<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="UnlockedAI.Views.SidebarView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="using:UnlockedAI.Controls"
    xmlns:vm="using:UnlockedAI.ViewModels"
    IsTabStop="False">

    <UserControl.Resources>
        <MenuFlyout x:Key="ItemMenu">
            <!-- The keys are handled by the list itself; the text here only shows them. -->
            <MenuFlyoutItem
                Click="OnRenameClick"
                KeyboardAcceleratorTextOverride="F2"
                Text="Rename">
                <MenuFlyoutItem.Icon>
                    <ui:IconView Icon="Edit" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem
                Click="OnDeleteClick"
                KeyboardAcceleratorTextOverride="Del"
                Text="Delete">
                <MenuFlyoutItem.Icon>
                    <ui:IconView Icon="Delete" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
        </MenuFlyout>
    </UserControl.Resources>

    <Grid Padding="{StaticResource Inset2}" RowSpacing="{StaticResource Space2}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:AppButton
            Grid.Row="0"
            HorizontalAlignment="Stretch"
            HorizontalContentAlignment="Left"
            Command="{x:Bind ViewModel.NewChatCommand, Mode=OneWay}"
            Content="New chat"
            Icon="Add"
            ToolTipService.ToolTip="New chat (Ctrl+N)" />

        <ui:ErrorMessage
            Grid.Row="1"
            DismissCommand="{x:Bind ViewModel.DismissErrorCommand, Mode=OneWay}"
            Error="{x:Bind ViewModel.Error, Mode=OneWay}" />

        <ListView
            x:Name="ConversationList"
            Grid.Row="2"
            AutomationProperties.Name="Chats"
            ContextRequested="OnListContextRequested"
            ItemsSource="{x:Bind ViewModel.Conversations, Mode=OneWay}"
            KeyDown="OnListKeyDown"
            SelectedItem="{x:Bind ViewModel.Selected, Mode=TwoWay}"
            SelectionMode="Single">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:ConversationItemViewModel">
                    <ui:ConversationListItem Title="{x:Bind Title, Mode=OneWay}" />
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <TextBlock
            Grid.Row="2"
            Margin="{StaticResource Inset3}"
            Style="{StaticResource CaptionText}"
            Text="Chats you start are saved here."
            Visibility="{x:Bind ui:Visible.If(ViewModel.HasNoConversations), Mode=OneWay}" />

        <ui:AppButton
            Grid.Row="3"
            HorizontalAlignment="Stretch"
            HorizontalContentAlignment="Left"
            Click="OnSettingsClick"
            Content="Settings"
            Icon="Settings"
            Variant="Ghost" />
    </Grid>
</UserControl>
