<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="UnlockedAI.Controls.ToolCallCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="using:UnlockedAI.Controls"
    IsTabStop="False">

    <Border
        Padding="{StaticResource Inset3}"
        Background="{StaticResource CardBrush}"
        BorderBrush="{StaticResource ControlStrokeBrush}"
        BorderThickness="{StaticResource StrokeThin}"
        CornerRadius="{StaticResource RadiusControl}">
        <StackPanel Spacing="{StaticResource Space2}">

            <!-- What tool, and how the call is going. -->
            <Grid ColumnSpacing="{StaticResource Space2}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ui:IconView
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Foreground="{StaticResource TextSecondaryBrush}"
                    Icon="{x:Bind ui:ToolCallCard.ToolIcon(Call.ToolName), Mode=OneWay}" />
                <TextBlock
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Style="{StaticResource BodyStrongText}"
                    Text="{x:Bind Call.Title, Mode=OneWay}" />
                <ui:BusyIndicator
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    IsActive="{x:Bind Call.IsRunning, Mode=OneWay}"
                    Visibility="{x:Bind ui:Visible.If(Call.IsRunning), Mode=OneWay}" />
                <ui:IconView
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    Foreground="{x:Bind ui:ToolCallCard.StatusBrush(Call.State), Mode=OneWay}"
                    Icon="{x:Bind ui:ToolCallCard.StatusIcon(Call.State), Mode=OneWay}"
                    Visibility="{x:Bind ui:Visible.IfNot(Call.IsRunning), Mode=OneWay}" />
                <TextBlock
                    Grid.Column="3"
                    VerticalAlignment="Center"
                    Style="{StaticResource CaptionText}"
                    Text="{x:Bind Call.StatusText, Mode=OneWay}" />
            </Grid>

            <!-- Exactly what will run or be fetched, so the user approves the real thing. -->
            <Border
                Padding="{StaticResource InsetCell}"
                Background="{StaticResource InsetBrush}"
                CornerRadius="{StaticResource RadiusControl}">
                <TextBlock
                    IsTextSelectionEnabled="True"
                    MaxLines="8"
                    Style="{StaticResource MonoText}"
                    Text="{x:Bind Call.Summary, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="Wrap" />
            </Border>

            <StackPanel
                Orientation="Horizontal"
                Spacing="{StaticResource Space2}"
                Visibility="{x:Bind ui:Visible.If(Call.IsAwaitingApproval), Mode=OneWay}">
                <ui:AppButton
                    Command="{x:Bind Call.AllowOnceCommand, Mode=OneWay}"
                    Content="Allow once"
                    Variant="Primary" />
                <ui:AppButton Command="{x:Bind Call.AllowForChatCommand, Mode=OneWay}" Content="Always allow in this chat" />
                <ui:AppButton
                    Command="{x:Bind Call.DenyCommand, Mode=OneWay}"
                    Content="Don't allow"
                    Variant="Ghost" />
            </StackPanel>

            <StackPanel Spacing="{StaticResource Space2}" Visibility="{x:Bind ui:Visible.If(Call.HasOutput), Mode=OneWay}">
                <ui:AppButton
                    HorizontalAlignment="Left"
                    Command="{x:Bind Call.ToggleOutputCommand, Mode=OneWay}"
                    Content="{x:Bind Call.OutputToggleText, Mode=OneWay}"
                    Icon="{x:Bind ui:ToolCallCard.ToggleIcon(Call.IsOutputVisible), Mode=OneWay}"
                    Variant="Ghost" />
                <Border
                    Padding="{StaticResource InsetCell}"
                    Background="{StaticResource InsetBrush}"
                    CornerRadius="{StaticResource RadiusControl}"
                    Visibility="{x:Bind ui:Visible.If(Call.IsOutputVisible), Mode=OneWay}">
                    <ScrollViewer
                        MaxHeight="{StaticResource ToolOutputMaxHeight}"
                        HorizontalScrollBarVisibility="Auto"
                        HorizontalScrollMode="Auto"
                        VerticalScrollBarVisibility="Auto">
                        <TextBlock
                            IsTextSelectionEnabled="True"
                            Style="{StaticResource MonoText}"
                            Text="{x:Bind Call.Output, Mode=OneWay}"
                            TextWrapping="NoWrap" />
                    </ScrollViewer>
                </Border>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
