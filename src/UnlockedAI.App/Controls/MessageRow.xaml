<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="UnlockedAI.Controls.MessageRow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="using:UnlockedAI.Controls"
    xmlns:vm="using:UnlockedAI.ViewModels"
    IsTabStop="False">

    <Border
        x:Name="Root"
        Padding="{StaticResource InsetMessage}"
        Background="{StaticResource TransparentBrush}"
        CornerRadius="{StaticResource RadiusPanel}">

        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="RoleStates">
                <VisualState x:Name="Assistant" />
                <VisualState x:Name="User">
                    <VisualState.Setters>
                        <Setter Target="Root.Background" Value="{StaticResource CardBrush}" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <StackPanel Spacing="{StaticResource Space1}">
            <Grid MinHeight="{StaticResource ControlHeightCompact}">
                <TextBlock
                    VerticalAlignment="Center"
                    Style="{StaticResource CaptionStrongText}"
                    Text="{x:Bind Message.RoleLabel, Mode=OneWay}" />
                <ui:CopyButton
                    HorizontalAlignment="Right"
                    Label="Copy message"
                    Text="{x:Bind Message.Text, Mode=OneWay}"
                    Visibility="{x:Bind ui:Visible.IfNot(Message.IsStreaming), Mode=OneWay}" />
            </Grid>

            <ItemsControl
                AutomationProperties.Name="Attached files"
                IsTabStop="False"
                ItemsSource="{x:Bind Message.Attachments, Mode=OneWay}"
                Visibility="{x:Bind ui:Visible.If(Message.HasAttachments), Mode=OneWay}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ui:WrapPanel Spacing="{StaticResource Space2}" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:AttachmentViewModel">
                        <ui:Chip
                            Detail="{x:Bind Detail}"
                            Icon="Document"
                            Text="{x:Bind Name}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- What the user typed is shown as typed; the model's reply is rendered as markdown. -->
            <ui:MarkdownView
                x:Name="Body"
                Margin="{StaticResource InsetMessageBody}"
                IsPlainText="{x:Bind Message.IsUser, Mode=OneWay}"
                Text="{x:Bind Message.Text, Mode=OneWay}" />

            <ui:BusyIndicator
                HorizontalAlignment="Left"
                AutomationProperties.Name="Writing a reply"
                IsActive="{x:Bind Message.IsStreaming, Mode=OneWay}"
                Visibility="{x:Bind ui:Visible.If(Message.IsStreaming), Mode=OneWay}" />
        </StackPanel>
    </Border>
</UserControl>
