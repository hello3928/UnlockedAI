<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="UnlockedAI.Controls.EmptyState"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="using:UnlockedAI.Controls"
    IsTabStop="False">

    <StackPanel
        MaxWidth="{StaticResource EmptyStateWidth}"
        HorizontalAlignment="Center"
        VerticalAlignment="Center"
        Spacing="{StaticResource Space2}">
        <ui:IconView
            Margin="{StaticResource Inset2}"
            HorizontalAlignment="Center"
            FontSize="{StaticResource IconSizeLarge}"
            Foreground="{StaticResource TextTertiaryBrush}"
            Icon="{x:Bind Icon, Mode=OneWay}"
            Visibility="{x:Bind IconVisibility(Icon), Mode=OneWay}" />
        <TextBlock
            HorizontalAlignment="Center"
            AutomationProperties.HeadingLevel="Level2"
            Style="{StaticResource SubtitleText}"
            Text="{x:Bind Title, Mode=OneWay}"
            TextAlignment="Center" />
        <TextBlock
            HorizontalAlignment="Center"
            Style="{StaticResource BodyMutedText}"
            Text="{x:Bind Message, Mode=OneWay}"
            TextAlignment="Center"
            Visibility="{x:Bind ui:Visible.IfText(Message), Mode=OneWay}" />
        <ui:AppButton
            Margin="{StaticResource Inset2}"
            HorizontalAlignment="Center"
            Command="{x:Bind ActionCommand, Mode=OneWay}"
            Content="{x:Bind ActionText, Mode=OneWay}"
            Variant="Primary"
            Visibility="{x:Bind ui:Visible.IfText(ActionText), Mode=OneWay}" />
    </StackPanel>
</UserControl>
