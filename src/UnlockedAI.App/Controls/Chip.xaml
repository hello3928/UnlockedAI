<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="UnlockedAI.Controls.Chip"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="using:UnlockedAI.Controls"
    IsTabStop="False">

    <Border
        MinHeight="{StaticResource ControlHeight}"
        Padding="{StaticResource InsetChip}"
        Background="{StaticResource ControlBrush}"
        BorderBrush="{StaticResource ControlStrokeBrush}"
        BorderThickness="{StaticResource StrokeThin}"
        CornerRadius="{StaticResource RadiusControl}">
        <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space2}">
            <ui:IconView
                VerticalAlignment="Center"
                Foreground="{StaticResource TextSecondaryBrush}"
                Icon="{x:Bind Icon, Mode=OneWay}" />
            <TextBlock
                MaxWidth="{StaticResource ChipTextWidth}"
                VerticalAlignment="Center"
                Style="{StaticResource BodyText}"
                Text="{x:Bind Text, Mode=OneWay}"
                TextTrimming="CharacterEllipsis"
                TextWrapping="NoWrap"
                ToolTipService.ToolTip="{x:Bind Text, Mode=OneWay}" />
            <TextBlock
                VerticalAlignment="Center"
                Style="{StaticResource CaptionText}"
                Text="{x:Bind Detail, Mode=OneWay}"
                Visibility="{x:Bind ui:Visible.IfText(Detail), Mode=OneWay}" />
            <ui:IconButton
                VerticalAlignment="Center"
                Click="OnRemoveClick"
                Icon="Close"
                IsCompact="True"
                Label="{x:Bind RemoveLabel(Text), Mode=OneWay}"
                Visibility="{x:Bind ui:Visible.If(IsRemovable), Mode=OneWay}" />
            <!-- Keeps the right edge balanced when there is no remove button. -->
            <Border Width="{StaticResource Space1}" Visibility="{x:Bind ui:Visible.IfNot(IsRemovable), Mode=OneWay}" />
        </StackPanel>
    </Border>
</UserControl>
