<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="UnlockedAI.Controls.Notice"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="using:UnlockedAI.Controls">

    <Border
        x:Name="Root"
        Padding="{StaticResource Inset3}"
        AutomationProperties.LiveSetting="Polite"
        Background="{StaticResource CardBrush}"
        BorderBrush="{StaticResource ControlStrokeBrush}"
        BorderThickness="{StaticResource StrokeThin}"
        CornerRadius="{StaticResource RadiusControl}">

        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="SeverityStates">
                <VisualState x:Name="Info" />
                <VisualState x:Name="Success">
                    <VisualState.Setters>
                        <Setter Target="Root.Background" Value="{StaticResource SuccessSurfaceBrush}" />
                        <Setter Target="SeverityIcon.Foreground" Value="{StaticResource SuccessBrush}" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Warning">
                    <VisualState.Setters>
                        <Setter Target="Root.Background" Value="{StaticResource WarningSurfaceBrush}" />
                        <Setter Target="SeverityIcon.Foreground" Value="{StaticResource WarningBrush}" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Error">
                    <VisualState.Setters>
                        <Setter Target="Root.Background" Value="{StaticResource ErrorSurfaceBrush}" />
                        <Setter Target="SeverityIcon.Foreground" Value="{StaticResource ErrorBrush}" />
                        <Setter Target="Root.(AutomationProperties.LiveSetting)" Value="Assertive" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid ColumnSpacing="{StaticResource Space3}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ui:IconView
                x:Name="SeverityIcon"
                Grid.Column="0"
                Margin="{StaticResource Inset1}"
                VerticalAlignment="Top"
                Foreground="{StaticResource AccentBrush}" />

            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock
                    Style="{StaticResource BodyStrongText}"
                    Text="{x:Bind Title, Mode=OneWay}"
                    Visibility="{x:Bind ui:Visible.IfText(Title), Mode=OneWay}" />
                <TextBlock
                    IsTextSelectionEnabled="True"
                    Style="{StaticResource BodyText}"
                    Text="{x:Bind Message, Mode=OneWay}"
                    Visibility="{x:Bind ui:Visible.IfText(Message), Mode=OneWay}" />
            </StackPanel>

            <ui:AppButton
                Grid.Column="2"
                VerticalAlignment="Center"
                Click="OnActionClick"
                Command="{x:Bind ActionCommand, Mode=OneWay}"
                Content="{x:Bind ActionText, Mode=OneWay}"
                Visibility="{x:Bind ui:Visible.IfText(ActionText), Mode=OneWay}" />

            <ui:IconButton
                Grid.Column="3"
                VerticalAlignment="Top"
                Click="OnDismissClick"
                Icon="Close"
                Label="Dismiss"
                Visibility="{x:Bind ui:Visible.If(IsDismissible), Mode=OneWay}" />
        </Grid>
    </Border>
</UserControl>
